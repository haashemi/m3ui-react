{
  "name": "m3ui-react",
  "version": "0.0.0",
  "private": true,
  "description": "Material 3 Expressive components for React, distributed as a shadcn registry.",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haashemi/m3ui-react.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run @m3ui/www#dev",
    "build": "vp run theme && vp run registry:build && vp run @m3ui/www#build",
    "theme": "node --import ./scripts/node-hooks.ts scripts/build-theme.ts",
    "registry:build": "shadcn build registry.json --output apps/www/public/r",
    "ready": "vp check && vp test && vp run build",
    "prepare": "vp hooks enable"
  },
  "devDependencies": {
    "@fullstacksjs/oxlint-config": "1.3.2",
    "@m3ui/tokens": "workspace:*",
    "@shadcn/lint": "0.2.5",
    "@types/node": "26.6.6",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite-plus": "1.8.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.6.0"
}
